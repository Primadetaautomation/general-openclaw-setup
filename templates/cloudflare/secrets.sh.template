#!/bin/bash
# Moltbot Cloudflare Workers - Secrets Setup
# Generated by create-moltbot
#
# Usage: bash secrets.sh
# Requires: wrangler CLI (npm install -g wrangler)
# Make sure you're logged in: wrangler login

set -e

echo "Setting Cloudflare Workers secrets for Moltbot..."
echo ""

SUCCESS=0
FAILED=0

{{#each secrets}}
echo "Setting {{key}}..."
echo "{{value}}" | wrangler secret put {{key}} && SUCCESS=$((SUCCESS+1)) || FAILED=$((FAILED+1))
{{/each}}

echo ""
echo "Done! $SUCCESS secrets set successfully, $FAILED failed."
